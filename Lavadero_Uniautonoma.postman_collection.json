{
  "info": {
    "name": "Lavadero Uniautónoma",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "estudianteId",
      "value": ""
    },
    {
      "key": "vehiculoId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Registrar estudiante",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Laura Gómez\",\n  \"codigo\": \"20231001\",\n  \"correo\": \"laura@uniautonoma.edu.co\",\n  \"programa\": \"Ingeniería de Sistemas\",\n  \"telefono\": \"3001234567\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data) pm.collectionVariables.set('estudianteId', j.data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Listar/filtrar estudiantes",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes?programa=sistemas",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes"
          ],
          "query": [
            {
              "key": "programa",
              "value": "sistemas"
            }
          ]
        }
      }
    },
    {
      "name": "3. Consultar estudiante",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes/{{estudianteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes",
            "{{estudianteId}}"
          ]
        }
      }
    },
    {
      "name": "4. Actualizar estudiante",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes/{{estudianteId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes",
            "{{estudianteId}}"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"telefono\": \"3109998877\",\n  \"correo\": \"laura.nuevo@uniautonoma.edu.co\"\n}"
        }
      }
    },
    {
      "name": "5. Registrar vehículo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/vehiculos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehiculos"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"placa\": \"ABC123\",\n  \"tipo\": \"carro\",\n  \"marca\": \"Mazda\",\n  \"color\": \"Rojo\",\n  \"estudiante\": \"{{estudianteId}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const j = pm.response.json();",
              "if (j.data) pm.collectionVariables.set('vehiculoId', j.data._id);"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Buscar vehículo por placa",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/vehiculos?placa=abc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehiculos"
          ],
          "query": [
            {
              "key": "placa",
              "value": "abc"
            }
          ]
        }
      }
    },
    {
      "name": "7. Registrar lavado (fidelidad)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/lavados",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "lavados"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"estudiante\": \"{{estudianteId}}\",\n  \"vehiculo\": \"{{vehiculoId}}\",\n  \"tipoLavado\": \"basico\"\n}"
        }
      }
    },
    {
      "name": "8. Consultar fidelidad",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes/{{estudianteId}}/fidelidad",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes",
            "{{estudianteId}}",
            "fidelidad"
          ]
        }
      }
    },
    {
      "name": "9. Historial de lavados filtrado",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/lavados?estudiante={{estudianteId}}&gratis=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "lavados"
          ],
          "query": [
            {
              "key": "estudiante",
              "value": "{{estudianteId}}"
            },
            {
              "key": "gratis",
              "value": "true"
            }
          ]
        }
      }
    },
    {
      "name": "10. Eliminar vehículo",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/vehiculos/{{vehiculoId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "vehiculos",
            "{{vehiculoId}}"
          ]
        }
      }
    },
    {
      "name": "Extra: error 404 (id inexistente)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes/64b000000000000000000000",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes",
            "64b000000000000000000000"
          ]
        }
      }
    },
    {
      "name": "Extra: error 400 (datos inválidos)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/estudiantes",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "estudiantes"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Sin datos\"\n}"
        }
      }
    }
  ]
}